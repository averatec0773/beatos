{
  "_note": "Verified LIVE on the NetEase 音乐人 beat-upload page (Ant Design v3) via Playwright on 2026-05-30. Native text fields use placeholder selectors. Interaction fields use stable data-ne2e-name anchors + click drivers (apps/extension/src/interaction-fill.ts). KEY: 音名 C-B (single), 调号 ♯/♭/无 (single), 调式 Major/Minor… (multi) — picks are scoped per-trigger via aria-controls so stacked dropdowns can't race. 说明标签 is a vertical-tab modal (适用场景/情绪表达/自定义); the driver switches tabs to find moods. 授权设置 is a right-side DRAWER (NOT a modal), multi-step: check 租赁授权 → 售价 inputs appear; the driver fills the first 售价 best-effort and NEVER clicks 保存 (human reviews + submits).",
  "match": ["https://music.163.com/*"],
  "fields": {
    "title":       { "selector": "input[placeholder*='请输入Beat名称']", "type": "text" },
    "bpm":         { "selector": "input[placeholder*='每分钟拍子数']", "type": "text" },
    "description": { "selector": "textarea[placeholder*='对beat作品的介绍']", "type": "textarea" },
    "genre": {
      "type": "antv3-select",
      "triggerSelector": "[data-ne2e-name='beatGenre'] .ant-select-selection",
      "optionContainer": ".ant-select-dropdown:not(.ant-select-dropdown-hidden)",
      "optionItem": ".ant-select-dropdown-menu-item",
      "match": "prefix"
    },
    "key": {
      "type": "key-triple",
      "note":       { "triggerSelector": "[data-ne2e-name='beatKey'] .ant-select-selection", "triggerIndex": 0, "optionContainer": ".ant-select-dropdown:not(.ant-select-dropdown-hidden)", "optionItem": ".ant-select-dropdown-menu-item" },
      "accidental": { "triggerSelector": "[data-ne2e-name='beatKey'] .ant-select-selection", "triggerIndex": 1, "optionContainer": ".ant-select-dropdown:not(.ant-select-dropdown-hidden)", "optionItem": ".ant-select-dropdown-menu-item", "labelMap": { "sharp": "♯", "flat": "♭", "natural": "无" } },
      "mode":       { "triggerSelector": "[data-ne2e-name='beatKey'] .ant-select-selection", "triggerIndex": 2, "optionContainer": ".ant-select-dropdown:not(.ant-select-dropdown-hidden)", "optionItem": ".ant-select-dropdown-menu-item", "labelMap": { "major": "Major", "minor": "Minor" } }
    },
    "mood": {
      "type": "tag-modal",
      "sourceKeys": ["mood", "tags"],
      "triggerSelector": "[data-ne2e-name='beatTagGroups'] button",
      "triggerText": "添加标签",
      "modal": ".ant-modal",
      "tabSelector": ".ant-tabs-tab",
      "tabTexts": ["适用场景", "情绪表达"],
      "activePanel": ".ant-tabs-tabpane-active",
      "tagButton": "button",
      "selectedClass": "beatButtonChoose",
      "confirmText": "确定"
    },
    "price": {
      "type": "license-modal",
      "triggerSelector": "[data-ne2e-name='beatAuthConfig'] [class*='buttonContainer']",
      "triggerText": "添加授权方式",
      "drawer": ".ant-drawer-open",
      "optionSelector": ".defaultView--2Kp-o",
      "licenseType": "租赁授权",
      "freeLicenseType": "免费授权",
      "tiersKey": "price_tiers",
      "rowContainer": ".multiSelectorView--21Ufr",
      "rowItem": ".selectorSubItem--1vBQj",
      "rowTitles": { "mp3": "MP3", "wav": "MP3+WAV", "stem": "MP3+WAV+分轨文件" },
      "priceInput": "input[type='number'][placeholder*='售价']",
      "shareInput": "input[type='number'][placeholder*='编曲分润比例']"
    }
  }
}
