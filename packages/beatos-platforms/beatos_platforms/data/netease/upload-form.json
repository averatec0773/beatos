{
  "_note": "Selectors are best-effort and MUST be verified against the live NetEase upload page. Field keys mirror ExportResult keys.",
  "match": ["https://music.163.com/*upload*", "https://music.163.com/st/musician*"],
  "fields": {
    "title":       { "selector": "input[name='songName'], input#songName", "type": "text" },
    "genre":       { "selector": "select[name='genre'], select.genre", "type": "select" },
    "mood":        { "selector": "input[name='mood'], input.mood-tags", "type": "tags" },
    "bpm":         { "selector": "input[name='bpm']", "type": "text" },
    "key":         { "selector": "input[name='key']", "type": "text" },
    "description": { "selector": "textarea[name='description'], textarea.desc", "type": "textarea" },
    "tags":        { "selector": "input[name='tags'], input.tag-input", "type": "tags" },
    "price":       { "selector": "input[name='price'], input.price", "type": "text" }
  }
}
