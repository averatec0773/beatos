{
  "_note": "Verified against the live NetEase 音乐人 beat-upload page (Ant Design v3) on 2026-05-29. Native text fields (title/bpm/description) use placeholder selectors. Interaction fields (genre/key/mood/price) use stable data-ne2e-name anchors + click drivers (apps/extension/src/interaction-fill.ts). KEY: 音名 C-B, 调号 ♯/♭/无, 调式 English Major/Minor (multi-select). 说明标签 is a fixed scene-tag-button modal (mood/tags best-effort). Price modal selectors are best-effort — calibrate against the live modal.",
  "match": ["https://music.163.com/*"],
  "fields": {
    "title":       { "selector": "input[placeholder*='请输入Beat名称']", "type": "text" },
    "bpm":         { "selector": "input[placeholder*='每分钟拍子数']", "type": "text" },
    "description": { "selector": "textarea[placeholder*='对beat作品的介绍']", "type": "textarea" },
    "genre": {
      "type": "antv3-select",
      "triggerSelector": "[data-ne2e-name='beatGenre'] .ant-select-selection",
      "optionContainer": ".ant-select-dropdown:not(.ant-select-dropdown-hidden)",
      "optionItem": ".ant-select-dropdown-menu-item",
      "match": "prefix"
    },
    "key": {
      "type": "key-triple",
      "note":       { "triggerSelector": "[data-ne2e-name='beatKey'] .ant-select-selection", "triggerIndex": 0, "optionContainer": ".ant-select-dropdown:not(.ant-select-dropdown-hidden)", "optionItem": ".ant-select-dropdown-menu-item" },
      "accidental": { "triggerSelector": "[data-ne2e-name='beatKey'] .ant-select-selection", "triggerIndex": 1, "optionContainer": ".ant-select-dropdown:not(.ant-select-dropdown-hidden)", "optionItem": ".ant-select-dropdown-menu-item", "labelMap": { "sharp": "♯", "flat": "♭", "natural": "无" } },
      "mode":       { "triggerSelector": "[data-ne2e-name='beatKey'] .ant-select-selection", "triggerIndex": 2, "optionContainer": ".ant-select-dropdown:not(.ant-select-dropdown-hidden)", "optionItem": ".ant-select-dropdown-menu-item", "labelMap": { "major": "Major", "minor": "Minor" } }
    },
    "mood": {
      "type": "tag-modal",
      "sourceKeys": ["mood", "tags"],
      "triggerSelector": "[data-ne2e-name='beatTagGroups'] button",
      "triggerText": "添加标签",
      "modal": ".ant-modal",
      "confirmText": "确定"
    },
    "price": {
      "type": "license-modal",
      "triggerSelector": "[data-ne2e-name='beatAuthConfig'] [class*='buttonContainer']",
      "triggerText": "添加授权方式",
      "modal": ".ant-modal",
      "priceInput": ".ant-modal input.ant-input-number-input, .ant-modal input[type='number'], .ant-modal input",
      "confirmText": "确定",
      "tierMap": {}
    }
  }
}
