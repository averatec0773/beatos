{
  "name": "beatos-extension",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/background.ts src/content.ts --bundle --format=esm --outdir=dist && node -e \"require('fs').copyFileSync('manifest.json','dist/manifest.json')\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.270",
    "esbuild": "^0.24.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
