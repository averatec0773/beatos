{
  "manifest_version": 3,
  "name": "BeatOS Uploader",
  "version": "0.1.0",
  "description": "Auto-fill platform upload forms with metadata staged from BeatOS. You drag the audio file and submit yourself.",
  "host_permissions": [
    "http://127.0.0.1:48923/*",
    "https://music.163.com/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://music.163.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
